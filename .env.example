# YouTube Data API v3 key — SERVER-ONLY. Never expose with NEXT_PUBLIC_.
# Get one at https://console.cloud.google.com/apis/credentials (enable "YouTube Data API v3").
# On Vercel, set this as a server Environment Variable in the dashboard — never commit a real value.
YOUTUBE_API_KEY=

# Optional: force the UU full-uploads fallback globally (UULF→UU + client-side Shorts filter, D2).
# Default is UULF-primary; set to "false" only if the UULF prefix stops resolving. Per-channel
# auto-fallback runs regardless of this flag (see src/lib/youtube.ts getChannelUploads).
CT_USE_UULF=

# Optional: show the dev quota badge in production. Unset/anything-but-"1" hides it in prod.
CT_SHOW_QUOTA=
