# YouTube Data API v3 key — SERVER-ONLY. Never expose with NEXT_PUBLIC_.
# Get one at https://console.cloud.google.com/apis/credentials (enable "YouTube Data API v3").
YOUTUBE_API_KEY=

# Optional: data-layer cache window in seconds for Data API reads (default 1800 = 30 min,
# matching the RSS poll cadence). Lower it while developing if you want fresher data.
CT_REVALIDATE_SECONDS=1800
